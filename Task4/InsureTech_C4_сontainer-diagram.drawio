                <object placeholders="1" c4Type="Relationship" c4Technology="REST / SOAP / GraphQL" c4Description="Фоновое опрашивание, параллельная обработка &#10;(Circuit Breaker, Retry, только при изменениях)" label="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color:#ff0000;&quot;&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="change-1.2-1.3-combined">
