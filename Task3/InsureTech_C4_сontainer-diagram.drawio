                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="910" y="180" width="240" height="120" as="geometry"/>
                    </mxCell>
                </object>
                <object placeholders="1" c4Type="ins-comp-settlement-db" c4Container="Container" c4Technology="PostgreSQL" c4Description="БД используется для хранения данных клиентов: ФИО, телефон, паспорт и др. Информация необходима для оформления страховок" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Type%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Container%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ckVUTfoMV_SZnMC_Z-Nl-2">
                    <mxCell style="shape=cylinder3;size=6.172056136592715;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];resizable=0;" parent="1" vertex="1">
                        <mxGeometry x="1300" y="180" width="240" height="120" as="geometry"/>
                    </mxCell>
                </object>
                <object placeholders="1" c4Type="Relationship" c4Technology="TCP" c4Description="Работа с данными" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="ckVUTfoMV_SZnMC_Z-Nl-3">
                    <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="ckVUTfoMV_SZnMC_Z-Nl-1" target="ckVUTfoMV_SZnMC_Z-Nl-2" edge="1">
                        <mxGeometry x="-0.1429" width="240" relative="1" as="geometry">
                            <mxPoint x="1040" y="800" as="sourcePoint"/>
                            <mxPoint x="1040" y="920" as="targetPoint"/>
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </object>
                <object placeholders="1" c4Type="Relationship" c4Technology="REST" c4Description="Получение/сохранение информации о клиентах" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="ckVUTfoMV_SZnMC_Z-Nl-4">
                    <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="uZ0quFO-MIEIE11IO5jD-3" target="ckVUTfoMV_SZnMC_Z-Nl-1" edge="1">
                        <mxGeometry x="0.3548" width="240" relative="1" as="geometry">
                            <mxPoint x="740" y="500" as="sourcePoint"/>
                            <mxPoint x="920" y="500" as="targetPoint"/>
                            <mxPoint as="offset"/>
                            <Array as="points">
                                <mxPoint x="830" y="450"/>
                                <mxPoint x="830" y="280"/>
                            </Array>
                        </mxGeometry>
                    </mxCell>
                </object>
                <object placeholders="1" c4Type="Relationship" c4Technology="REST" c4Description="Получение/сохранение&#10; информации о клиентах" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="ckVUTfoMV_SZnMC_Z-Nl-5">
                    <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="uZ0quFO-MIEIE11IO5jD-4" target="ckVUTfoMV_SZnMC_Z-Nl-1" edge="1">
                        <mxGeometry width="240" relative="1" as="geometry">
                            <mxPoint x="740" y="460" as="sourcePoint"/>
                            <mxPoint x="920" y="290" as="targetPoint"/>
                            <mxPoint x="-1" as="offset"/>
                            <Array as="points">
                                <mxPoint x="820" y="220"/>
                                <mxPoint x="820" y="220"/>
                            </Array>
                        </mxGeometry>
                    </mxCell>
                </object>
                <mxCell id="change-1.1-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffcccc;padding:8px;border:3px solid #ff0000&quot;&gt;&lt;b&gt;Изменение 1.1: Переход на Event-Streaming архитектуру (красным)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; При росте количества страховых компаний с 5 до 10 время агрегации данных увеличится пропорционально&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Увеличение времени ответа для core-app, блокировка процесса формирования реестра в ins-comp-settlement, потенциальные таймауты&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Переход на Event-Streaming архитектуру. ins-product-aggregator публикует события об изменении продуктов в Message Broker (Kafka). Сервисы core-app и ins-comp-settlement подписываются на эти события и обновляют локальные кэши асинхронно. Это устраняет необходимость периодических запросов и позволяет обрабатывать изменения в реальном времени.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Асинхронная обработка изменений в реальном времени&lt;br&gt;&amp;nbsp; • Устранение периодических запросов и снижение нагрузки&lt;br&gt;&amp;nbsp; • Независимое масштабирование подписчиков&lt;br&gt;&amp;nbsp; • Улучшение времени ответа и устранение блокировок&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff0000;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="450" y="1190" width="600" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="change-1.2-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffcccc;padding:8px;border:3px solid #ff0000&quot;&gt;&lt;b&gt;Изменение 1.2: Оптимизация использования ресурсов (красным)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; core-app запрашивает данные каждые 15 минут, даже если изменения не произошли&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Избыточная нагрузка на ins-product-aggregator и внешние API страховых компаний&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; При использовании Event-Streaming обновление данных происходит только при реальных изменениях. ins-product-aggregator опрашивает страховые компании в фоновом режиме и публикует события только при обнаружении изменений. Это значительно снижает нагрузку на систему.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Обновление данных только при реальных изменениях&lt;br&gt;&amp;nbsp; • Снижение нагрузки на ins-product-aggregator и внешние API&lt;br&gt;&amp;nbsp; • Эффективное использование ресурсов&lt;br&gt;&amp;nbsp; • Фоновое опрашивание не блокирует основной поток&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff0000;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="1190" width="600" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="change-1.3-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffcccc;padding:8px;border:3px solid #ff0000&quot;&gt;&lt;b&gt;Изменение 1.3: Оптимизация времени обработки (красным)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; При последовательных запросах время обработки = сумма времени всех запросов&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; При 10 компаниях общее время может достигать 5 секунд, пользователи видят задержки&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Асинхронная обработка запросов к страховым компаниям в ins-product-aggregator с использованием паттернов Circuit Breaker и Retry. Параллельная обработка запросов к нескольким компаниям. При сбое одной компании остальные продолжают обрабатываться, обеспечивая частичную доступность данных.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Параллельная обработка запросов сокращает общее время&lt;br&gt;&amp;nbsp; • Circuit Breaker предотвращает каскадные сбои&lt;br&gt;&amp;nbsp; • Retry обеспечивает надежность при временных сбоях&lt;br&gt;&amp;nbsp; • Частичная доступность данных при сбое отдельных компаний&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff0000;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="1460" width="600" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="change-2.1-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffcccc;padding:8px;border:3px solid #ff0000&quot;&gt;&lt;b&gt;Изменение 2.1: Защита от каскадных сбоев (красным)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; Если одна из страховых компаний недоступна, весь процесс агрегации может завершиться неудачей&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; core-app не получает данные, ins-comp-settlement не может сформировать реестр, пользователи видят устаревшие данные&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Внедрение механизма graceful degradation в ins-product-aggregator. При недоступности одной компании система продолжает работать с данными от доступных компаний. Использование Circuit Breaker для изоляции проблемных API. События публикуются для доступных данных, подписчики получают частичные обновления.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Система продолжает работать при недоступности части компаний&lt;br&gt;&amp;nbsp; • Circuit Breaker изолирует проблемные API&lt;br&gt;&amp;nbsp; • Частичные обновления обеспечивают актуальность данных&lt;br&gt;&amp;nbsp; • Предотвращение каскадных сбоев и полной недоступности сервиса&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff0000;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1500" width="600" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="change-2.2-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffcccc;padding:8px;border:3px solid #ff0000&quot;&gt;&lt;b&gt;Изменение 2.2: Гарантия доставки данных (красным)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; При сбое запроса от ins-comp-settlement к core-app данные об оформленных страховках могут быть потеряны&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Невозможность формирования полного реестра для взаиморасчётов, финансовые потери&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Использование паттерна Transactional Outbox в core-app. При создании страховки событие записывается в таблицу Outbox в той же транзакции, что и основная запись. Outbox Publisher публикует события из Outbox в Message Broker, гарантируя доставку даже при сбоях. ins-comp-settlement подписывается на события о создании страховок вместо периодических запросов.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Гарантия доставки событий даже при сбоях&lt;br&gt;&amp;nbsp; • Атомарность записи данных и событий&lt;br&gt;&amp;nbsp; • Устранение периодических запросов&lt;br&gt;&amp;nbsp; • Надёжное формирование реестра для взаиморасчётов&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff0000;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1810" width="600" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="change-2.3-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffcccc;padding:8px;border:3px solid #ff0000&quot;&gt;&lt;b&gt;Изменение 2.3: Независимая обработка компаний (красным)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; При недоступности хотя бы одной компании блокируется весь процесс&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Полная остановка обновления данных о продуктах&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Реализация частичной обработки (graceful degradation). ins-product-aggregator обрабатывает запросы к доступным компаниям независимо, публикуя события для каждой компании отдельно. Подписчики получают обновления от доступных компаний, система продолжает работать частично.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Независимая обработка каждой компании&lt;br&gt;&amp;nbsp; • Публикация событий для каждой компании отдельно&lt;br&gt;&amp;nbsp; • Система продолжает работать при недоступности части компаний&lt;br&gt;&amp;nbsp; • Частичная доступность данных вместо полной остановки&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff0000;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="1740" width="600" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="change-3.1-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ccffcc;padding:8px;border:3px solid #00cc00&quot;&gt;&lt;b&gt;Изменение 3.1: Согласованность данных (зеленым)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; Локальные кэши в core-app и ins-comp-settlement обновляются с разной частотой (15 минут vs 24 часа)&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Несогласованность данных между сервисами, пользователи видят разные тарифы&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; При переходе на Event-Streaming оба сервиса подписываются на одни и те же события об изменении продуктов. Обновление происходит одновременно для всех подписчиков при публикации события, обеспечивая согласованность данных в реальном времени.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Одновременное обновление всех подписчиков&lt;br&gt;&amp;nbsp; • Согласованность данных в реальном времени&lt;br&gt;&amp;nbsp; • Устранение расхождений между сервисами&lt;br&gt;&amp;nbsp; • Единообразие данных для всех пользователей&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccffcc;strokeColor=#00cc00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2120" width="600" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="change-3.2-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ccffcc;padding:8px;border:3px solid #00cc00&quot;&gt;&lt;b&gt;Изменение 3.2: Единый источник истины (зеленым)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; Данные хранятся в нескольких местах без синхронизации&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Расхождение данных между сервисами, сложность отладки&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Message Broker становится единым каналом распространения данных. ins-product-aggregator является источником истины для данных о продуктах, публикуя события в Message Broker. Все подписчики получают одинаковые данные, что упрощает отладку и поддержку.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Единый источник истины для данных о продуктах&lt;br&gt;&amp;nbsp; • Единый канал распространения данных&lt;br&gt;&amp;nbsp; • Все подписчики получают одинаковые данные&lt;br&gt;&amp;nbsp; • Упрощение отладки и поддержки&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccffcc;strokeColor=#00cc00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="2020" width="600" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="change-4.1-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffffcc;padding:8px;border:3px solid #ffcc00&quot;&gt;&lt;b&gt;Изменение 4.1: Масштабируемость (желтым)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; При добавлении новых страховых компаний нагрузка растёт линейно&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Необходимость горизонтального масштабирования, увеличение инфраструктурных затрат&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Event-Streaming архитектура позволяет масштабировать обработку независимо. ins-product-aggregator публикует события один раз, а обработка распределяется между множеством подписчиков. Message Broker (Kafka) обеспечивает горизонтальное масштабирование и высокую пропускную способность.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Независимое масштабирование подписчиков&lt;br&gt;&amp;nbsp; • Горизонтальное масштабирование Message Broker&lt;br&gt;&amp;nbsp; • Высокая пропускная способность&lt;br&gt;&amp;nbsp; • Эффективное использование ресурсов&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#ffcc00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="450" y="2400" width="600" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="change-4.2-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffffcc;padding:8px;border:3px solid #ffcc00&quot;&gt;&lt;b&gt;Изменение 4.2: Обработка больших объёмов данных (желтым)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; Запрос всех оформленных страховок за день может стать проблематичным при росте бизнеса&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Таймауты, перегрузка сети, невозможность формирования реестра&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Замена синхронного запроса на асинхронную обработку событий. core-app публикует события о создании страховок через Transactional Outbox. ins-comp-settlement подписывается на эти события и обрабатывает их по мере поступления, накапливая данные для формирования реестра. Это устраняет необходимость запрашивать все данные сразу.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Асинхронная обработка событий по мере поступления&lt;br&gt;&amp;nbsp; • Устранение необходимости запрашивать все данные сразу&lt;br&gt;&amp;nbsp; • Предотвращение таймаутов и перегрузки сети&lt;br&gt;&amp;nbsp; • Накопление данных для формирования реестра&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#ffcc00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="2280" width="600" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="change-4.3-note" value="&lt;div style=&quot;font-size: 12px;font-family:Arial;color:#000000;background-color:#ffffcc;padding:8px;border:3px solid #ffcc00&quot;&gt;&lt;b&gt;Изменение 4.3: Асинхронная обработка (желтым)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема:&lt;/b&gt; Синхронные запросы блокируют выполнение до получения ответа&lt;br&gt;&lt;br&gt;&lt;b&gt;Влияние:&lt;/b&gt; Снижение пропускной способности системы&lt;br&gt;&lt;br&gt;&lt;b&gt;Решение:&lt;/b&gt; Переход на асинхронную обработку через Message Broker. Сервисы не блокируются ожиданием ответа, обработка происходит независимо. Это значительно повышает пропускную способность системы и позволяет обрабатывать больше запросов параллельно.&lt;br&gt;&lt;br&gt;&lt;b&gt;Преимущества:&lt;/b&gt;&lt;br&gt;&amp;nbsp; • Отсутствие блокировки выполнения&lt;br&gt;&amp;nbsp; • Независимая обработка событий&lt;br&gt;&amp;nbsp; • Повышение пропускной способности&lt;br&gt;&amp;nbsp; • Параллельная обработка запросов&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#ffcc00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2690" width="600" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>